# Copy to .env.local and fill values privately. Never commit real secrets.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/sentinel"

# Use a random secret of at least 32 characters.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret-of-32-characters-minimum"

# Password hash format: salt:128-character-scrypt-hex.
# Generate a unique salt and hash locally; never put the plaintext password here.
ADMIN_PASSWORD_HASH="replace-with-salt-and-scrypt-hash"
